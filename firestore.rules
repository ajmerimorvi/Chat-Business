rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        request.auth.uid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId;
    }

    function isBusinessStaff(businessId) {
      return isAuthenticated() && (
        isBusinessOwner(businessId) ||
        exists(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid))
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || request.resource.data.role == 'customer'
      );
      // Privilege fields (role, ownedBusinessIds, staffAtBusinessIds) cannot be altered by normal client
      allow update: if isOwner(userId) && (
        isAdmin() || (
          request.resource.data.id == resource.data.id &&
          (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('ownedBusinessIds' in resource.data) || request.resource.data.ownedBusinessIds == resource.data.ownedBusinessIds) &&
          (!('staffAtBusinessIds' in resource.data) || request.resource.data.staffAtBusinessIds == resource.data.staffAtBusinessIds)
        )
      );
      allow delete: if isAdmin();
    }

    // 2. Businesses collection (Publicly searchable)
    match /businesses/{businessId} {
      allow read: if true; // Public discovery
      // Any new business (manual or bulk import) MUST be created with UNVERIFIED status
      allow create: if isAuthenticated() && (
        isAdmin() || request.resource.data.ownerId == request.auth.uid
      ) && (
        !('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'UNVERIFIED'
      );
      // Verification status/badges are strictly protected and can only be altered by admin / verified system
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isBusinessOwner(businessId) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.id == resource.data.id &&
          (!('verification' in resource.data) || request.resource.data.verification == resource.data.verification) &&
          (!('verificationStatus' in resource.data) || request.resource.data.verificationStatus == resource.data.verificationStatus)
        )
      );
      allow delete: if isBusinessOwner(businessId) || isAdmin();

      // Staff subcollection
      match /staff/{staffId} {
        allow read: if isAuthenticated();
        allow write: if isBusinessOwner(businessId) || isAdmin();
      }

      // Verification events audit subcollection (authoritative, admin/trusted-backend only)
      match /verificationEvents/{eventId} {
        allow read: if isAuthenticated() && (isBusinessOwner(businessId) || isAdmin());
        allow write: if isAdmin();
      }
    }

    // 3. Products & Services (Publicly readable)
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && isBusinessStaff(request.resource.data.businessId);
      allow update: if isAuthenticated() && 
        isBusinessStaff(resource.data.businessId) &&
        request.resource.data.businessId == resource.data.businessId;
      allow delete: if isAuthenticated() && isBusinessStaff(resource.data.businessId);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated() && isBusinessStaff(request.resource.data.businessId);
      allow update: if isAuthenticated() && 
        isBusinessStaff(resource.data.businessId) &&
        request.resource.data.businessId == resource.data.businessId;
      allow delete: if isAuthenticated() && isBusinessStaff(resource.data.businessId);
    }

    // 4. Conversations & Messages (Private to participants)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds ||
        (resource.data.businessId != null && isBusinessStaff(resource.data.businessId))
      );

      // Creator must be an authenticated participant
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participantIds;

      // Updating conversation metadata (last message, unread count) must not alter participants or business ID
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds ||
        (resource.data.businessId != null && isBusinessStaff(resource.data.businessId))
      ) &&
      request.resource.data.participantIds == resource.data.participantIds &&
      request.resource.data.businessId == resource.data.businessId;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds ||
          (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.businessId != null &&
            isBusinessStaff(get(/databases/$(database)/documents/conversations/$(conversationId)).data.businessId)
          )
        );

        // Strict message creation: senderId must match authenticated user AND user must belong to conversation
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid &&
          (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds ||
            (
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.businessId != null &&
              isBusinessStaff(get(/databases/$(database)/documents/conversations/$(conversationId)).data.businessId)
            )
          );

        // Receipts update (delivered, read) allowed by participants; immutable fields (senderId, text, timestamp, type, conversationId) cannot be altered
        allow update: if isAuthenticated() && (
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds ||
           (get(/databases/$(database)/documents/conversations/$(conversationId)).data.businessId != null &&
            isBusinessStaff(get(/databases/$(database)/documents/conversations/$(conversationId)).data.businessId))) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.conversationId == resource.data.conversationId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.text == resource.data.text &&
          request.resource.data.timestamp == resource.data.timestamp
        );
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // 5. Inquiries (Customer + Business Staff)
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessStaff(resource.data.businessId)
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessStaff(resource.data.businessId)
      ) &&
      request.resource.data.customerId == resource.data.customerId &&
      request.resource.data.businessId == resource.data.businessId;
    }

    // 6. Verification Requests (Owner can submit, Admin can review)
    match /verificationRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 7. Authoritative Verification Records & Audits (Admin / Trusted Backend only)
    match /verificationRecords/{recordId} {
      allow read: if isAuthenticated() && (
        isBusinessOwner(resource.data.businessId) || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // 8. Safety Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // 9. Bulk Business Import Audits (Admin only)
    match /businessImports/{importId} {
      allow read, write: if isAdmin();
    }

    // 10. Future Sales Team & Field Verifications
    match /businessVerifications/{verificationId} {
      allow read: if isAuthenticated() && (
        isBusinessOwner(resource.data.businessId) || isAdmin()
      );
      allow write: if isAdmin();
    }
  }
}
